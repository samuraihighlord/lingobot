# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
# From @BotFather (/newbot). Also turn on Inline Mode in BotFather > Bot Settings.
TELEGRAM_BOT_TOKEN=

# From platform.claude.com > API Keys. Not needed when MOCK_AI=1.
ANTHROPIC_API_KEY=

# --- Speech-to-text (voice notes + voice replies) ---
# Leave empty until you have one: text messages still work, voice shows a clear message.
# Deepgram is used when its key is set (console.deepgram.com > API Keys); otherwise OpenAI.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe

# --- AI model ---
CLAUDE_MODEL=claude-haiku-5-5

# --- Server ---
PORT=8787

# --- Cost protection (see README "Protecting your API credits") ---
# Comma-separated Telegram user IDs allowed to use the bot. Empty = anyone who pairs.
ALLOWED_TELEGRAM_IDS=
# Max translations/transcriptions per user per day (UTC).
MAX_REQUESTS_PER_USER_PER_DAY=60
# Max for the whole bot per day. When reached, the bot pauses until tomorrow.
MAX_REQUESTS_GLOBAL_PER_DAY=400
# Longest voice note / voice reply accepted, in seconds.
MAX_VOICE_SECONDS=120

# --- Development ---
# 1 = fake translations, no Claude/OpenAI calls (free UI testing).
MOCK_AI=0
# 1 = enable POST /dev/inject to push a fake message to the glasses without Telegram.
DEV_ENDPOINTS=0
# 1 = run the HTTP/WebSocket server without connecting to Telegram.
DISABLE_BOT=0
