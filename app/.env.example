# Copy to .env.local. Address of your LingoBot server.
# Simulator on the same computer: http://localhost:8787
# Real glasses: use your laptop's Wi-Fi IP (e.g. http://192.168.1.20:8787) or your deployed HTTPS URL,
# and add the same URL (http + ws, or https + wss) to the whitelist in app.json.
VITE_BACKEND_URL=http://localhost:8787
